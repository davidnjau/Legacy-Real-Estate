DJANGO_SECRET_KEY=replace-this-for-local-development
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,core

POSTGRES_DB=legacy_core
POSTGRES_USER=legacy
POSTGRES_PASSWORD=legacy_local_only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0

# Local browser portal origin(s); use the deployed frontend origin in each environment.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Production finance-role sign-in requires a configured SMS delivery backend.
# The development console backend is enabled automatically only when DEBUG=1.
# AUTH_SMS_BACKEND=your_sms_backend.DjangoBackend
AUTH_SMS_CODE_LIFETIME_SECONDS=300
AUTH_SMS_MAX_ATTEMPTS=5
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_SECONDS=900
