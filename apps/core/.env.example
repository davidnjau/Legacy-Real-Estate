DJANGO_SECRET_KEY=replace-this-for-local-development
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,core

POSTGRES_DB=legacy_core
POSTGRES_USER=legacy
POSTGRES_PASSWORD=legacy_local_only
POSTGRES_HOST=localhost
POSTGRES_PORT=55432

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=amqp://legacy_worker:local-legacy-worker-only@localhost:5672//

# Local private object storage for tenant maintenance evidence.
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=localminio
OBJECT_STORAGE_SECRET_KEY=local-only-change-before-sharing
OBJECT_STORAGE_BUCKET=legacy-private
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_AUTO_CREATE_BUCKET=1

# Local browser portal origin(s); use the deployed frontend origin in each environment.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
PUBLIC_SITE_URL=http://localhost:3000

# Local email is delivered to Mailpit; browse http://localhost:8025.
EMAIL_DELIVERY_BACKEND=mailpit
DEFAULT_FROM_EMAIL=noreply@example.test
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=0

# Configure the delivery provider outside local development.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Legacy Real Estate

# Softlink API key is a secret; set it through the deployment secret manager.
# Use AUTH_SMS_BACKEND=users.sms.SoftlinkSMSBackend to enable provider delivery.
# Traffic class currently follows the Softlink request example; confirm this choice with the provider.
SOFTLINK_SMS_API_URL=https://api.softlinksms.co.ke/api/v1/sms
SOFTLINK_SMS_API_KEY=
SOFTLINK_SMS_TRAFFIC_CLASS=promotional
SOFTLINK_SMS_TIMEOUT_SECONDS=10

# Finance-role sign-in requires a configured SMS delivery backend.
# The development console backend is enabled automatically only when DEBUG=1.
# AUTH_SMS_BACKEND=users.sms.SoftlinkSMSBackend
AUTH_SMS_CODE_LIFETIME_SECONDS=300
AUTH_SMS_MAX_ATTEMPTS=5
AUTH_SMS_MAX_DELIVERY_ATTEMPTS=5
AUTH_MFA_CHALLENGE_TTL_SECONDS=300
AUTH_MFA_MAX_ATTEMPTS=5
AUTH_DIRECTOR_ACTIVATION_TTL_SECONDS=900
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_SECONDS=900
AUTH_SESSION_AGE_SECONDS=28800
