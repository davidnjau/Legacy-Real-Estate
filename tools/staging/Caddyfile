{$STAGING_DOMAIN} {
    encode gzip

    redir /mailpit /mailpit/ 308

    handle_path /mailpit/* {
        rewrite * /mailpit{path}
        reverse_proxy mailpit:8025 {
            header_up Host {host}
        }
    }

    handle /api/v1/* {
        reverse_proxy core:8000
    }

    @director_portal path /admin/dashboard* /admin/staff* /admin/audit* /admin/financials* /admin/properties* /admin/settings*
    handle @director_portal {
        reverse_proxy website:3000
    }

    handle /admin/* {
        reverse_proxy core:8000
    }

    handle {
        reverse_proxy website:3000
    }
}
